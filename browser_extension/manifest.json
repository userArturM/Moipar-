{
  "manifest_version": 3,
  "name": "Bitora Password Manager",
  "version": "4.8.2",
  "description": "Сохранение и заполнение паролей через Bitora Password Manager с подтверждением в Windows.",
  "permissions": [
    "activeTab",
    "nativeMessaging",
    "scripting",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Bitora Password Manager",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png"
    }
  },
  "key": "",
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
