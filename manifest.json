name: Build Moi Paroli (exe + installer)

on:
  push:
  workflow_dispatch:

permissions:
  contents: write

jobs:
  build:
    runs-on: windows-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: Install dependencies
        run: pip install cryptography pyinstaller pystray pillow openpyxl winrt-Windows.Security.Credentials.UI

      - name: Run regression tests
        run: python -m unittest discover -s tests -v

      - name: Build exe
        run: pyinstaller --onefile --noconsole --name MoiParoli --icon icon.ico --collect-submodules pystray --hidden-import pystray._win32 --collect-submodules winrt moi_paroli.py

      - name: Build Native Messaging host
        run: pyinstaller --onefile --noconsole --name browser_host --hidden-import cryptography browser_host.py

      - name: Install Inno Setup
        run: choco install innosetup --no-progress -y

      - name: Build installer
        shell: pwsh
        run: '& "C:\Program Files (x86)\Inno Setup 6\ISCC.exe" installer.iss'

      - name: Verify Windows binaries and checksums
        run: python tools/verify_windows_build.py

      - name: Upload build manifest
        uses: actions/upload-artifact@v4
        with:
          name: MoiParoli-build-checksums
          path: dist/BUILD_MANIFEST.json

      - name: Upload native messaging host
        uses: actions/upload-artifact@v4
        with:
          name: MoiParoli-BrowserHost
          path: |
            dist/browser_host.exe
            browser_extension/**
            register_browser_host.py

      - name: Upload installer
        uses: actions/upload-artifact@v4
        with:
          name: MoiParoli-Setup
          path: installer_out/MoiParoli-Setup.exe

      - name: Upload portable exe
        uses: actions/upload-artifact@v4
        with:
          name: MoiParoli-portable
          path: dist/MoiParoli.exe

      - name: Publish release (only for tags like v3.2)
        if: startsWith(github.ref, 'refs/tags/v')
        uses: softprops/action-gh-release@v2
        with:
          files: |
            installer_out/MoiParoli-Setup.exe
            dist/MoiParoli.exe
